# Oura API v2 OAuth2認証情報。実の値は、プロジェクトのフォルダ直下（起動フォルダ）の .env に書くこと。
# プロジェクトのスキルはこの .env を共有する。同じキーの環境変数があれば、読むときはそちらが優先される。
# スキルパッケージ内には実値を含めない。
# client_id/client_secretは https://cloud.ouraring.com/oauth/applications で発行する。
# access_token/refresh_token/expires_atは `uv run <skill-dir>/scripts/oura_auth.py exchange <code>` 実行後に自動で書き込まれる(手動で埋める必要はない)。
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8765/callback
OURA_ACCESS_TOKEN=
OURA_REFRESH_TOKEN=
OURA_EXPIRES_AT=
